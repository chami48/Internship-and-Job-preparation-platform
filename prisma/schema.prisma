generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// Basic Post Model
//////////////////////////////////////////////////////

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

//////////////////////////////////////////////////////
// NextAuth Models (kept for future use)
//////////////////////////////////////////////////////

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}



model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  STUDENT
  COMPANY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          UserRole @default(STUDENT)     

  studentId     String?
  degree        String?
  year          String?   

  specialization String?
  skills        String?
  github        String?
  linkedin      String?
  portfolio     String?
  bio           String?

  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  posts    Post[]
  applications Application[]
  verification ApplicantVerification?
  prepQuizAttempts PrepQuizAttempt[]
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////
// Module 2 - Job Management
//////////////////////////////////////////////////////

enum JobType {
  INTERNSHIP
  FULL_TIME
}

enum JobLevel {
  JUNIOR
  MID
  SENIOR
}

model Company {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  description String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isVerified Boolean @default(false)
  otp        String?
  otpExpiry  DateTime?

  jobs        Job[]
}

model Job {
  id        String   @id @default(cuid())
  title     String

  company     Company @relation(fields: [companyId], references: [id])
  companyId   String

  location  String
  role      JobRole
  type      JobType
  level     JobLevel
  tags      String
  salary    String?

  description      String
  responsibilities String
  requirements     String
  benefits         String?

  deadline  DateTime?
  slots     Int?
  cutoff    Float     @default(60)   // pass threshold as percentage (e.g. 60 = 60%)

  createdAt DateTime @default(now())

  applications Application[]
}


//////////////////////////////////////////////////////
// Module 3 - Question Bank
//////////////////////////////////////////////////////

enum JobRole {
  SOFTWARE_ENGINEER
  UX_ENGINEER
  PROJECT_MANAGER
}

enum QuestionType {
  MCQ
  SCENARIO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id          String       @id @default(cuid())
  role        JobRole
  topic       String
  type        QuestionType
  difficulty  Difficulty
  prompt      String
  explanation String?
  createdAt   DateTime     @default(now())

  options    Option[]
  correctKey String?
  rubric     String?
  maxMarks   Float    @default(10)   // points available for this question

  examAnswers    ExamAnswer[]
  questionEvals  QuestionEvaluation[]

  @@index([role, difficulty, topic])
}

model Option {
  id         String @id @default(cuid())
  questionId String
  key        String
  text       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
}

//////////////////////////////////////////////////////
// Module 3 - Application System
//////////////////////////////////////////////////////

enum Specialization {
  INFORMATION_TECHNOLOGY
  SOFTWARE_ENGINEERING
  CYBER_SECURITY
  DATA_SCIENCE
  COMPUTER_SCIENCE_NETWORK_ENGINEERING
  INTERACTIVE_MEDIA
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  role      JobRole
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)


  fullName  String
  email     String
  mobile    String?
  linkedin  String?
  github    String?
  portfolio String?

  university     String
  degree         String
  specialization Specialization
  cgpa           String?
  awards         String?

  programmingLanguages String
  frameworks           String?
  softwareProficiency  String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  projects     Project[]
  scenarios    ScenarioAnswer[]
  examAnswers  ExamAnswer[]   
  violations ExamViolation[]

  lockedQuestions Json?
  examSubmitted   Boolean  @default(false)
  terminationReason String?

  evaluationResult  EvaluationResult?

  @@unique([userId, jobId])

}

model Project {
  id            String @id @default(cuid())
  applicationId String
  name          String
  details       String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ScenarioAnswer {
  id            String @id @default(cuid())
  applicationId String
  questionKey   String
  answer        String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ExamAnswer {
  id            String   @id @default(cuid())
  questionId    String
  applicationId String
  answer        String?
  createdAt     DateTime @default(now())

  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([applicationId])
}

model ExamViolation {
  id            String   @id @default(cuid())
  applicationId String
  type          ViolationType
  message       String
  createdAt     DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
enum ViolationType {
  FULLSCREEN_EXIT
  TAB_SWITCH
  COPY_PASTE_RIGHTCLICK
  SCREENSHOT_ATTEMPT
  DEV_TOOLS
  FACE_NOT_DETECTED
  MULTIPLE_FACES
}

model ApplicantVerification {
  id              String   @id @default(cuid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  studentIdNumber String
  idImageUrl      String
  createdAt       DateTime @default(now())
}

enum PrepQuizRole {
  SOFTWARE_ENGINEER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  QA_ENGINEER
  DEVOPS_ENGINEER
  DATA_ANALYST
  UI_UX_DESIGNER
  PROJECT_MANAGER
  BUSINESS_ANALYST
}

model PrepQuizQuestion {
  id          String          @id @default(cuid())
  role        PrepQuizRole
  question    String
  type        String          // MCQ or SHORT
  explanation String?
  createdAt   DateTime        @default(now())

  options     PrepQuizOption[]
  answers     PrepQuizAnswer[]
}

model PrepQuizOption {
  id         String   @id @default(cuid())
  questionId String
  key        String
  text       String
  isCorrect  Boolean

  question PrepQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
}

model PrepQuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  role      PrepQuizRole
  score     Int
  createdAt DateTime @default(now())

  answers PrepQuizAnswer[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrepQuizAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  selectedKey String
  isCorrect   Boolean

  attempt  PrepQuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PrepQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
//////////////////////////////////////////////////////
// Module 4 - AI Evaluation & Candidate Filtering
//////////////////////////////////////////////////////

enum EvalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model EvaluationResult {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  totalScore      Float
  maxScore        Float
  percentage      Float
  cutoff          Float
  passed          Boolean
  aiFeedback      String
  cvUploadGranted Boolean     @default(false)

  status          EvalStatus  @default(PENDING)
  evaluatedAt     DateTime    @default(now())

  questionEvals   QuestionEvaluation[]

  @@index([applicationId])
}

model QuestionEvaluation {
  id                  String           @id @default(cuid())
  evaluationResultId  String
  evaluationResult    EvaluationResult @relation(fields: [evaluationResultId], references: [id], onDelete: Cascade)

  questionId          String
  question            Question         @relation(fields: [questionId], references: [id])

  applicationId       String
  studentAnswer       String?
  expectedAnswer      String?
  scoreAwarded        Float
  maxMarks            Float
  aiFeedback          String

  createdAt           DateTime         @default(now())

  @@index([evaluationResultId])
  @@index([applicationId])
}